// ============================================
// OT Condo Outreach v1 (see docs/OT_OUTREACH_V1_RUNBOOK.md)
// Isolated from transactional product flows. Do not reuse these models for
// subscription email, order delivery, or marketing drips.
// ============================================

model OutreachProspect {
  id                        String    @id @default(cuid())
  campaignId                String?   @map("campaign_id")
  boardName                 String    @map("board_name")
  buildingName              String?   @map("building_name")
  buildingAddressRaw        String    @map("building_address_raw")
  buildingAddressNormalized String    @map("building_address_normalized")
  boardEmail                String    @map("board_email")
  boardEmailLowercase       String    @map("board_email_lowercase")
  sourceUrl                 String    @map("source_url")
  scrapedAt                 DateTime  @map("scraped_at")
  scraperVersion            String    @map("scraper_version")
  rowStatus                 String    @default("needs_review") @map("row_status") // ok | needs_review | rejected
  rawPayload                Json      @map("raw_payload")
  lastContactedAt           DateTime? @map("last_contacted_at")
  lastCampaignId            String?   @map("last_campaign_id")
  contactCount              Int       @default(0) @map("contact_count")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  campaign OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sends    OutreachSend[]
  replies  OutreachReply[]
  leads    OutreachLead[]

  @@unique([buildingAddressNormalized, boardEmailLowercase], name: "outreach_prospects_addr_email_uq")
