  order                 OTOrder               @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, createdAt])
  @@map("ot_neutral_refund_work")
}

enum OTNeutralManualDeliveryStatus {
  PREPARED
  RECORDED
  CONFIRMED
  VOIDED
}

/// Durable, insert-only operator classification of one order. It exists so an
/// owner test can never be counted as a served customer. Closed class and note
/// codes only; no clear text and no PII.
model OTNeutralOrderClassification {
  orderId      String   @id @map("order_id")
  class        String
  actorKey     String   @map("actor_key")
  noteCode     String?  @map("note_code")
  classifiedAt DateTime @default(now()) @map("classified_at") @db.Timestamptz(3)

  order OTOrder @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ot_neutral_order_classification")
}

/// Append-only audit of operator artifact reads. `sha256` is the digest of the
/// bytes actually served, written only after the storage helper verified them;
/// `reservationBundleSha256` pins the reservation identity in force when they
/// were served, which is what binds a QA approval to non-stale bytes.
model OTNeutralOperatorArtifactRead {
  id                      String   @id
  reservationId           String   @map("reservation_id")
  orderId                 String   @map("order_id")
  actorKey                String   @map("actor_key")
  purpose                 String
  artifactKind            String   @map("artifact_kind")
  sha256                  String
  reservationBundleSha256 String   @map("reservation_bundle_sha256")
  byteSize                Int      @map("byte_size")
  servedAt                DateTime @default(now()) @map("served_at") @db.Timestamptz(3)

  reservation OTNeutralReportReservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       OTOrder                    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservationId, actorKey, purpose, servedAt])
  @@map("ot_neutral_operator_artifact_read")
}

/// Human attestation ledger for a manual send. Defined in Slice 1 so the Slice 2
/// transition store is code-only; Slice 1 grants the runtime role no write path
/// to it. RECORDED means an operator states they sent these exact bytes;
/// CONFIRMED means they state they hold confirmation evidence. Neither is
/// inferred, and neither is a provider fact.
model OTNeutralManualDelivery {
  id                         String                        @id
  reservationId              String                        @map("reservation_id")
  orderId                    String                        @map("order_id")
  qaReviewId                 String                        @map("qa_review_id")
  fulfillmentId              String                        @map("fulfillment_id")
  customerArtifactSha256     String                        @map("customer_artifact_sha256")
  policyVersion              String                        @map("policy_version")
  propertyBindingFingerprint String                        @map("property_binding_fingerprint")
  paymentBindingSha256       String                        @map("payment_binding_sha256")
  status                     OTNeutralManualDeliveryStatus @default(PREPARED)
  statusRevision             Int                           @default(0) @map("status_revision")
  preparedBy                 String                        @map("prepared_by")
  preparedAt                 DateTime                      @default(now()) @map("prepared_at") @db.Timestamptz(3)
  prepareExpiresAt           DateTime                      @map("prepare_expires_at") @db.Timestamptz(3)
  recordedBy                 String?                       @map("recorded_by")
  recordedAt                 DateTime?                     @map("recorded_at") @db.Timestamptz(3)
  channelCode                String?                       @map("channel_code")
  externalReferenceSha256    String?                       @map("external_reference_sha256")
  recipientBindingSha256     String?                       @map("recipient_binding_sha256")
  confirmedBy                String?                       @map("confirmed_by")
  confirmedAt                DateTime?                     @map("confirmed_at") @db.Timestamptz(3)
  confirmationCode           String?                       @map("confirmation_code")
  voidedBy                   String?                       @map("voided_by")
  voidedAt                   DateTime?                     @map("voided_at") @db.Timestamptz(3)
  voidReasonCode             String?                       @map("void_reason_code")
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservation OTNeutralReportReservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order       OTOrder                    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qaReview    OTNeutralQaReview          @relation(fields: [qaReviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fulfillment OTFulfillment              @relation(fields: [fulfillmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  artifact    OTFulfillmentArtifact      @relation(fields: [fulfillmentId, customerArtifactSha256], references: [fulfillmentId, artifactSha256], onDelete: NoAction, onUpdate: NoAction, map: "ot_neutral_manual_delivery_artifact_fkey")

  @@index([status, updatedAt])
  @@map("ot_neutral_manual_delivery")
}

