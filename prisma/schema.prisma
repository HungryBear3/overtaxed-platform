  providerAttemptKey    String?               @unique @map("provider_attempt_key")
  providerReceiptId     String?               @unique @map("provider_receipt_id")
  providerReceiptSha256 String?               @unique @map("provider_receipt_sha256")
  verificationReason    String?               @map("verification_reason")
