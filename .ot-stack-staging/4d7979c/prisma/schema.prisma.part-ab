}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PacketStatus {
  NOT_STARTED // Invoice created, payment pending
  GENERATING // Payment confirmed, packet being built
  READY // PDF generated and stored
  DELIVERED // Delivery email sent at least once
  MANUAL_REVIEW // Weak data (no comps, missing requested value, etc.) — truthful fallback
  FAILED // Generation error after payment; ops should intervene
}

// ============================================
// Monitoring & Automation
// ============================================

model MonitoringJob {
  id String @id @default(cuid())

  jobType MonitoringJobType
  status  JobStatus         @default(PENDING)

  // What was checked
  propertiesChecked Int @default(0)
  assessmentsFound  Int @default(0)
  appealsTriggered  Int @default(0)

  // Errors
  errors   String[] // Error messages
  warnings String[] // Warning messages

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([jobType])
  @@index([status])
  @@index([startedAt])
}

enum MonitoringJobType {
  ASSESSMENT_CHECK // Check for new assessments
  APPEAL_FILING // File pending appeals
  COMP_GENERATION // Generate comp packets
  DEADLINE_REMINDER // Send deadline reminders
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================
// Township Deadline Alerts (free lead gen)
// ============================================

model TownshipAlert {
  id       String  @id @default(cuid())
  email    String
  township String // e.g. "Worth", "Bremen", "Orland"
  district String? // e.g. "South", "North"

  // Notification state
  notifiedOpen  Boolean @default(false) // Emailed when window opened
  notifiedClose Boolean @default(false) // Emailed 7 days before close

  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique @default(cuid())

  @@unique([email, township])
  @@index([email])
  @@index([township])
  @@index([notifiedOpen])
  @@index([notifiedClose])
}

// ============================================
// Visitor Counter
// ============================================

model VisitorCount {
  date  DateTime @id @db.Date
  count Int      @default(0)

  @@map("visitor_count")
}

// ============================================
// System Config (key-value for app-wide settings)
// ============================================
// Used for rep code, business email, etc. when filing on behalf of property owners.

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "COOK_COUNTY_REP_CODE", "FILING_BUSINESS_EMAIL"
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================
// County Configuration (for future expansion)
// ============================================

model CountyConfig {
  id String @id @default(cuid())

  county String @unique // e.g., "Cook", "DuPage"
  state  String @default("IL")

  // Appeal rules
  appealDeadlineDays Int      @default(30) // Days from notice
  appealTypes        String[] // ["assessor", "board_review"]

  // Data sources
  openDataUrl String?
  apiUrl      String?
  apiKey      String?

  // Form requirements
  requiresPhotos       Boolean @default(true)
  photoDateRequirement Int? // Days (e.g., within 365 days)
  minCompsRequired     Int     @default(3)

  isActive Boolean @default(false) // MVP: Only Cook County active

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([county])
  @@index([state])
}

model OTLead {
  id               String   @id @default(cuid())
  email            String
  address          String
  potentialSavings Float
  createdAt        DateTime @default(now())
  followupStep     Int      @default(0)

  @@index([email])
  @@index([createdAt])
}

// Consent-based follow-up for the residential free-check flow. This is
// intentionally separate from TownshipAlert, cold outreach, and legacy drip.
model FreeCheckFollowupSubscriber {
  id                   String                     @id @default(cuid())
  email                String
  emailNormalized      String
  emailConsentAt       DateTime
  emailConsentSource   String
  emailConsentVersion  String
  phoneE164            String?
  smsConsentAt         DateTime?
  smsConsentSource     String?
  smsConsentVersion    String?
  township             String?
  propertyAddress      String?
  potentialSavings     Float?
  resultUrl            String                     @default("/")
  unsubscribeToken     String                     @unique @default(cuid())
  emailSuppressedAt    DateTime?
  smsSuppressedAt      DateTime?
  smsSuppressionReason String?
  completedAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  messages             FreeCheckFollowupMessage[]

  @@unique([emailNormalized, emailConsentVersion])
  @@index([emailNormalized])
  @@index([phoneE164])
  @@index([createdAt])
  @@map("free_check_followup_subscriber")
}

model FreeCheckFollowupMessage {
  id                String                      @id @default(cuid())
  subscriberId      String
  subscriber        FreeCheckFollowupSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  step              String
  channel           String
  idempotencyKey    String                      @unique
  scheduledFor      DateTime
  status            String                      @default("SCHEDULED")
  leaseUntil        DateTime?
  attempts          Int                         @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  failureCode       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([subscriberId, step, channel])
  @@index([status, scheduledFor])
  @@index([leaseUntil])
  @@map("free_check_followup_message")
}

model OTOrder {
  id                        String    @id @default(cuid())
  stripeSessionId           String?   @unique
  checkoutKey               String?   @unique
  tier                      String
  email                     String
  name                      String?
  phone                     String?
  propertyAddress           String?
  propertyPin               String?
  township                  String?
  windowStatus              String?
  windowOpenDate            DateTime?
  windowCloseDate           DateTime?
  windowSourceUpdated       String?
  windowVerifiedAt          DateTime?
  eligibilitySnapshot       Json?
  analysisAcknowledgedAt    DateTime?
  acknowledgmentVersion     String?
  acknowledgmentEvidence    Json?
  reassessmentNoticeDate    DateTime?
  reassessmentNoticeAddress String?
  noticeEvidence            Json?
  noticeReviewStatus        String?
  noticeReviewActionAt      DateTime?
  noticeReviewActionBy      String?
  contractKey               String?   @unique
  attempt                   Int       @default(0)
  checkoutSessionExpiresAt  DateTime?
  checkoutPriceId           String?
  checkoutProductId         String?
  checkoutAmountCents       Int?
  checkoutCurrency          String?
  settledAmountCents        Int?
  settledCurrency           String?
  recoveryStripeSessionId   String?
  recoveryStripeEventId     String?
  recoveryReason            String?
  amountPaid                Float     @default(0)
  status                    String    @default("PENDING")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Additive back-relation for the T2 delivery-evidence foundation (Phase 1).
  // Virtual only — the foreign key lives on ot_fulfillment; ot_order is unchanged.
  fulfillments OTFulfillment[]

  @@index([email])
  @@index([stripeSessionId])
  @@index([recoveryStripeSessionId])
  @@index([createdAt])
  @@map("ot_order")
}

model Referral {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String?
  visits         Int      @default(0)
  conversions    Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(10, 2)
  commissionRate Float    @default(0.20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DripEmail {
  id           String    @id @default(cuid())
  email        String
  sequence     String // "ot-township"
  step         Int // 1-5
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([scheduledFor, sentAt])
  @@index([email, sequence])
}

model ContingencyLead {
  id                     String   @id @default(cuid())
  fullName               String
  email                  String
  phone                  String
  propertyPin            String
  propertyAddress        String
  estimatedAssessedValue String?
  hearAboutUs            String?
  createdAt              DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model StripeEvent {
  id        String   @id // Stripe event ID (evt_...)
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("stripe_event")
}

// ============================================
// OT Condo Outreach v1 (see docs/OT_OUTREACH_V1_RUNBOOK.md)
// Isolated from transactional product flows. Do not reuse these models for
// subscription email, order delivery, or marketing drips.
// ============================================

model OutreachProspect {
  id                        String    @id @default(cuid())
  campaignId                String?   @map("campaign_id")
  boardName                 String    @map("board_name")
  buildingName              String?   @map("building_name")
  buildingAddressRaw        String    @map("building_address_raw")
  buildingAddressNormalized String    @map("building_address_normalized")
  boardEmail                String    @map("board_email")
  boardEmailLowercase       String    @map("board_email_lowercase")
  sourceUrl                 String    @map("source_url")
  scrapedAt                 DateTime  @map("scraped_at")
  scraperVersion            String    @map("scraper_version")
  rowStatus                 String    @default("needs_review") @map("row_status") // ok | needs_review | rejected
  rawPayload                Json      @map("raw_payload")
  lastContactedAt           DateTime? @map("last_contacted_at")
  lastCampaignId            String?   @map("last_campaign_id")
  contactCount              Int       @default(0) @map("contact_count")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  campaign OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sends    OutreachSend[]
  replies  OutreachReply[]
  leads    OutreachLead[]

  @@unique([buildingAddressNormalized, boardEmailLowercase], name: "outreach_prospects_addr_email_uq")
  @@index([boardEmailLowercase])
  @@index([rowStatus])
  @@index([lastContactedAt])
  @@map("outreach_prospects")
}

model OutreachCampaign {
  id          String    @id @default(cuid())
  name        String
  status      String    @default("draft") // draft | ready | running | paused | completed | halted
  utmCampaign String    @map("utm_campaign")
  sendLimit   Int       @default(50) @map("send_limit")
  haltedAt    DateTime? @map("halted_at")
  haltReason  String?   @map("halt_reason")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  prospects OutreachProspect[]
  sends     OutreachSend[]
  replies   OutreachReply[]
  leads     OutreachLead[]

  @@index([status])
  @@map("outreach_campaigns")
}

model OutreachSend {
  id                 String    @id @default(cuid())
  campaignId         String    @map("campaign_id")
  prospectId         String    @map("prospect_id")
  email              String
  messageId          String?   @map("message_id")
  customId           String    @unique @map("custom_id")
  provider           String    @default("resend")
  status             String    @default("queued") // queued | sent | delivered | delivery_delayed | bounced | complained | opened | clicked | suppressed | skipped
  skippedReason      String?   @map("skipped_reason")
  sentAt             DateTime? @map("sent_at")
  deliveredAt        DateTime? @map("delivered_at")
  openedAt           DateTime? @map("opened_at")
  clickedAt          DateTime? @map("clicked_at")
  bouncedAt          DateTime? @map("bounced_at")
  bounceType         String?   @map("bounce_type") // hard | soft
  bounceReason       String?   @map("bounce_reason")
  complainedAt       DateTime? @map("complained_at")
  replyToAddress     String    @map("reply_to_address")
  listUnsubscribeUrl String    @map("list_unsubscribe_url")
  templateVersion    String    @map("template_version")
  utmSource          String    @map("utm_source")
  utmMedium          String    @map("utm_medium")
  utmCampaign        String    @map("utm_campaign")
  utmContent         String?   @map("utm_content")
  utmTerm            String    @map("utm_term")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect OutreachProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([email])
  @@index([messageId])
  @@map("outreach_sends")
}

model OutreachSuppression {
  id             String   @id @default(cuid())
  email          String
  emailLowercase String   @map("email_lowercase")
  campaignId     String?  @map("campaign_id")
  reason         String // HARD_BOUNCED | SOFT_BOUNCED_REPEATED | COMPLAINED | MANUAL_OPT_OUT | ONE_CLICK_UNSUB | LEGAL_HOLD | ALREADY_CONTACTED_30D | ROLE_ADDRESS | INVALID_SYNTAX | PROPERTY_MANAGER
  source         String // webhook | manual | unsubscribe | preflight
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([emailLowercase])
  @@index([campaignId])
  @@map("outreach_suppression")
}

model OutreachWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @default("resend")
  providerEventId String    @map("provider_event_id")
  messageId       String?   @map("message_id")
  eventType       String    @map("event_type")
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")

  @@unique([provider, providerEventId], name: "outreach_webhook_events_provider_eventid_uq")
  @@index([messageId])
  @@index([eventType])
  @@map("outreach_webhook_events")
}

model OutreachReply {
  id         String    @id @default(cuid())
  campaignId String?   @map("campaign_id")
  prospectId String?   @map("prospect_id")
  email      String
  replyType  String    @map("reply_type") // opt_out | neutral | interested | legal | other
  subject    String?
  bodyText   String    @map("body_text")
  handledBy  String?   @map("handled_by")
  handledAt  DateTime? @map("handled_at")
  status     String    @default("new") // new | handled | escalated
  createdAt  DateTime  @default(now()) @map("created_at")

  campaign OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  prospect OutreachProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@map("outreach_replies")
}

model OutreachLead {
  id              String   @id @default(cuid())
  prospectId      String?  @map("prospect_id")
  campaignId      String?  @map("campaign_id")
  email           String
  source          String // outreach_email | reply | appeal_bulk | manual
  utmSource       String   @map("utm_source")
  utmMedium       String   @map("utm_medium")
  utmCampaign     String   @map("utm_campaign")
  utmContent      String?  @map("utm_content")
  utmTerm         String   @map("utm_term")
  qualified       Boolean  @default(false)
  qualifiedReason String?  @map("qualified_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  prospect OutreachProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([campaignId])
  @@index([createdAt])
  @@map("outreach_leads")
}

model OutreachApprovalPacket {
  id             String   @id @default(cuid())
  externalId     String   @unique @map("external_id")
  status         String
  organization   String
  contact        String
  role           String
  township       String
  units          Int      @default(0)
  channel        String
  subject        String
  summary        String
  ownerCountNote String   @map("owner_count_note")
  draftedBy      String   @map("drafted_by")
  updatedLabel   String   @map("updated_label")
  risk           String
  body           Json
  blockers       Json?
  replySnippet   String?  @map("reply_snippet")
  source         String   @default("workspace-docs")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  events OutreachApprovalEvent[]

  @@index([status, updatedAt])
  @@index([source])
  @@map("outreach_approval_packets")
}

model OutreachApprovalEvent {
  id        String   @id @default(cuid())
  packetId  String   @map("packet_id")
  action    String
  note      String?
  actor     String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")

  packet OutreachApprovalPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)

  @@index([packetId, createdAt])
  @@index([action, createdAt])
  @@map("outreach_approval_events")
}

// cache-bust: 1774495683

// ============================================
// OT T2 DELIVERY-EVIDENCE FOUNDATION (Phase 1 schema; Phase 2 Slice 1 kickoff)
// ============================================
// Durable fulfillment-evidence for anonymous paid T2 OTOrder rows. The billing
// settlement seam may create only the initial summary when the strict
// OT_T2_FULFILLMENT_EVIDENCE_ENABLED flag is exactly true. The flag is default-off;
// no artifact, attempt, event, packet, delivery, provider, or worker path is wired.
// All state language mirrors lib/fulfillment/*.
//
// Privacy invariants (enforced by __tests__/fulfillment/privacy.test.ts):
//   - no public bearer URLs, raw artifact bytes, raw provider payloads;
//   - no customer email/name/address/PIN, no auth/download/review tokens;
//   - private internal locators only; content identity is immutable/versioned.
// Historical orders are never classified delivered — they surface as
// NOT_STARTED or NEEDS_RECONCILIATION via lib/fulfillment/eligibility.ts.

enum OTFulfillmentKind {
  T2_APPEAL_EVIDENCE
}

enum OTFulfillmentStatus {
  NOT_STARTED
  NEEDS_RECONCILIATION
  INELIGIBLE
  INCOMPLETE_INPUT
  MANUAL_REVIEW
  ARTIFACT_PENDING
  ARTIFACT_READY
  DELIVERY_PENDING
  PROVIDER_ACCEPTED
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
  CANCELLED
}

enum OTDeliveryEventType {
  REQUESTED
  ACCEPTED
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
}

/// One compact fulfillment summary per logical order/kind. The status is folded
/// monotonically from the append-only event log; artifact/attempt detail lives in
/// the child tables. Lease fields are bounded worker metadata, not auth tokens.
model OTFulfillment {
  id             String              @id @default(cuid())
  orderId        String              @map("order_id")
  kind           OTFulfillmentKind
  status         OTFulfillmentStatus @default(NOT_STARTED)
  statusRevision Int                 @default(0) @map("status_revision")
  attemptCount   Int                 @default(0) @map("attempt_count")
  // Current-artifact identity is DERIVED, not stored: it is the highest-`version`
  // OTFulfillmentArtifact for this fulfillment. An unenforceable denormalized
  // version/SHA pair was removed so the summary can never disagree with the
  // immutable append-only artifact log.
  // Bounded worker lease metadata (no DB claim performed in Phase 1).
