  leaseOwner     String?             @map("lease_owner")
  leaseToken     String?             @map("lease_token")
  leaseExpiresAt DateTime?           @map("lease_expires_at")
  // Bounded non-PII reason/error code (from a closed allowlist).
  lastReasonCode String?             @map("last_reason_code")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  order     OTOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artifacts OTFulfillmentArtifact[]
  attempts  OTDeliveryAttempt[]
  events    OTDeliveryEvent[]
  adminEvents OTFulfillmentAdminEvent[]
  downloadCapabilities OTPacketDownloadCapability[]

  @@unique([orderId, kind])
  @@index([status])
  @@index([leaseExpiresAt])
  @@map("ot_fulfillment")
}

/// Actor-attributed, append-only evidence for the narrow one-way admin hold.
model OTFulfillmentAdminEvent {
  id            String              @id @default(cuid())
  fulfillmentId String              @map("fulfillment_id")
  action        String
  fromStatus    OTFulfillmentStatus @map("from_status")
  toStatus      OTFulfillmentStatus @map("to_status")
  fromRevision  Int                 @map("from_revision")
  toRevision    Int                 @map("to_revision")
  reasonCode    String              @map("reason_code")
  actorUserId   String              @map("actor_user_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  fulfillment OTFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@unique([fulfillmentId, toRevision])
  @@index([fulfillmentId, createdAt])
  @@map("ot_fulfillment_admin_event")
}

/// Append-only artifact-version records. Content identity is immutable: a given
/// (fulfillment, sha256) pair and a given (fulfillment, version) are unique, so a
/// different accepted artifact can never silently overwrite an existing one.
model OTFulfillmentArtifact {
  id               String   @id @default(cuid())
  fulfillmentId    String   @map("fulfillment_id")
  version          Int
  artifactSha256   String   @map("artifact_sha256")
  byteSize         Int      @map("byte_size")
  // PRIVATE internal locator (storage path/key) — never a public bearer URL.
  storageLocator   String   @map("storage_locator")
  generatorVersion String   @map("generator_version")
  templateVersion  String?  @map("template_version")
  createdAt        DateTime @default(now()) @map("created_at")

  // --- Phase 2 Slice 2: exact provenance binding (additive, nullable) ---
  // When the packet BYTES were generated, as distinct from when this evidence
  // row was inserted (`createdAt`).
  generatedAt                DateTime? @map("generated_at")
  // Denormalized authoritative order binding. Redundant with fulfillment.orderId
  // by design: it makes the artifact row self-describing, so a replay can detect
  // an order/fulfillment mismatch without a join.
  sourceOrderId              String?   @map("source_order_id")
  // Stable fingerprint of the property binding in effect at generation time, so
  // later drift is detectable without storing a second copy of the PIN/address.
  propertyBindingFingerprint String?   @map("property_binding_fingerprint")

  fulfillment OTFulfillment       @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  // Delivery attempts that sent THIS immutable artifact version (same fulfillment).
  attempts    OTDeliveryAttempt[]
  // Download capabilities bound to THIS immutable artifact version.
  downloadCapabilities OTPacketDownloadCapability[]

  @@unique([fulfillmentId, version])
  @@unique([fulfillmentId, artifactSha256])
  @@index([artifactSha256])
  @@index([sourceOrderId])
  @@map("ot_fulfillment_artifact")
}

/// Append-only delivery-attempt records. `idempotencyKey` is globally unique and
/// `(provider, providerMessageId)` is unique whenever a message ID exists. Because
/// `provider` is REQUIRED, the composite unique has no NULL-provider hole: two
/// pending attempts (provider set, message ID still NULL) stay distinct, but two
/// resolved attempts can never share a provider message ID. `artifactVersion` is
/// relationally bound to an immutable artifact of the SAME fulfillment via the
/// composite FK below, so an attempt can never reference a nonexistent or
/// foreign-fulfillment artifact; a delivery retry reuses that version (no regen).
model OTDeliveryAttempt {
  id                 String    @id @default(cuid())
  fulfillmentId      String    @map("fulfillment_id")
  attemptNumber      Int       @map("attempt_number")
  artifactVersion    Int       @map("artifact_version")
  idempotencyKey     String    @unique @map("idempotency_key")
  provider           String
  providerMessageId  String?   @map("provider_message_id")
  requestedAt        DateTime  @default(now()) @map("requested_at")
  providerAcceptedAt DateTime? @map("provider_accepted_at")
  deliveredAt        DateTime? @map("delivered_at")
  delayedAt          DateTime? @map("delayed_at")
  failedAt           DateTime? @map("failed_at")
  reasonCode         String?   @map("reason_code")
  createdAt          DateTime  @default(now()) @map("created_at")

  fulfillment OTFulfillment         @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  // Intra-evidence identity FK: NoAction (non-destructive). Deleting an artifact
  // must never silently erase attempts, and an artifact-version change must never
  // rewrite this downstream identity. Parent teardown removes attempts via the
  // fulfillment Cascade above; NoAction's end-of-statement check then passes.
  artifact    OTFulfillmentArtifact @relation(fields: [fulfillmentId, artifactVersion], references: [fulfillmentId, version], onDelete: NoAction, onUpdate: NoAction)
  events      OTDeliveryEvent[]

  @@unique([fulfillmentId, attemptNumber])
  @@unique([provider, providerMessageId])
  @@index([fulfillmentId])
  @@index([fulfillmentId, artifactVersion])
  @@map("ot_delivery_attempt")
}

/// Immutable append-only provider-event log. `(provider, providerEventId)` is the
/// dedup identity, unique so duplicate webhooks are idempotent. Every event is
/// relationally bound to a real attempt of the SAME fulfillment via the composite
/// FK below. `(fulfillmentId, sequence)` is UNIQUE — sequence is a locally assigned
/// monotonic fold order, so two conflicting events can never claim one slot.
/// Stores a bounded event type + reason code only — never a raw payload.
model OTDeliveryEvent {
  id              String              @id @default(cuid())
  fulfillmentId   String              @map("fulfillment_id")
  attemptNumber   Int                 @map("attempt_number")
  provider        String
  providerEventId String              @map("provider_event_id")
  eventType       OTDeliveryEventType @map("event_type")
  sequence        Int
  occurredAt      DateTime            @map("occurred_at")
  reasonCode      String?             @map("reason_code")
  receivedAt      DateTime            @default(now()) @map("received_at")

  fulfillment OTFulfillment     @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  // Intra-evidence identity FK: NoAction (non-destructive). Deleting an attempt
  // must never silently erase events, and an attempt-number change must never
  // rewrite this downstream identity. Parent teardown removes events via the
  // fulfillment Cascade above; NoAction's end-of-statement check then passes.
  attempt     OTDeliveryAttempt @relation(fields: [fulfillmentId, attemptNumber], references: [fulfillmentId, attemptNumber], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, providerEventId])
  @@unique([fulfillmentId, sequence])
  @@map("ot_delivery_event")
}

/// Secure, default-off customer download capability for one immutable T2 packet.
///
/// Only a persistent SHA-256 hash of a high-entropy capability value is stored.
/// The value itself exists in the issuing process and in the customer's POST
/// body and nowhere else: it is never a column, never a URL path/query segment,
/// and never written to a log. A row is bound to the exact artifact identity
/// (row id + version + content digest), to the authoritative order, and to the
/// property-binding fingerprint in force at issuance, so one capability can
/// never be replayed against a different packet, order, or property.
///
/// Lifecycle is durable, not inferred: `expiresAt` bounds it in time, `maxUses`
/// bounds it in count, and `revokedAt` ends it immediately. None of these three
/// replaces the authority re-read at download time — order settlement and
/// fulfillment status are read fresh on every use.
model OTPacketDownloadCapability {
  id                         String    @id @default(cuid())
  /// SHA-256 (lowercase hex) of the opaque capability value. Never the value.
  capabilityHash             String    @unique @map("capability_hash")
  fulfillmentId              String    @map("fulfillment_id")
  /// Denormalized artifact row id, re-verified against the joined artifact.
  artifactId                 String    @map("artifact_id")
  artifactVersion            Int       @map("artifact_version")
  artifactSha256             String    @map("artifact_sha256")
  sourceOrderId              String    @map("source_order_id")
  propertyBindingFingerprint String    @map("property_binding_fingerprint")
  issuedAt                   DateTime  @default(now()) @map("issued_at")
  expiresAt                  DateTime  @map("expires_at")
  maxUses                    Int       @map("max_uses")
  useCount                   Int       @default(0) @map("use_count")
  lastUsedAt                 DateTime? @map("last_used_at")
  revokedAt                  DateTime? @map("revoked_at")
  /// Bounded non-PII revocation code from the closed allowlist.
  revokedReasonCode          String?   @map("revoked_reason_code")
  createdAt                  DateTime  @default(now()) @map("created_at")

  fulfillment OTFulfillment         @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  /// Same composite identity FK the delivery attempt uses: a capability can only
  /// ever name an immutable artifact version of its OWN fulfillment.
  artifact    OTFulfillmentArtifact @relation(fields: [fulfillmentId, artifactVersion], references: [fulfillmentId, version], onDelete: NoAction, onUpdate: NoAction)

  @@index([fulfillmentId])
  @@index([expiresAt])
  @@map("ot_packet_download_capability")
}

/// Durable, idempotent quarantine record for stored artifact content whose bind
/// outcome is unknown or refused.
///
/// Recording is the ONLY action taken: nothing here deletes, overwrites, or
/// rewrites storage, because the same content address may already be bound by
/// another fulfillment. Ambiguity preserves the object. A later garbage
/// collector must coordinate atomically with the binding registry, re-check all
/// references at deletion time, and preserve on ambiguity.
///
/// Deliberately has NO foreign key to ot_fulfillment. A cascade would delete the
/// very record that says "bytes may exist in private storage", which is exactly
/// the fact an operator needs after the fulfillment row is gone.
model OTArtifactOrphanQuarantine {
  id               String   @id @default(cuid())
  /// Private internal content-addressed locator — never a public bearer URL.
  storageLocator   String   @map("storage_locator")
  /// The EXPECTED content digest of the bytes that may be stored at the locator.
  artifactSha256   String   @map("artifact_sha256")
  fulfillmentId    String   @map("fulfillment_id")
  sourceOrderId    String   @map("source_order_id")
  /// CONFIRMED when the upload returned a trustworthy created result; UNKNOWN
  /// when the write outcome was never observed and the object may or may not exist.
  uploadOutcome    String   @map("upload_outcome")
  firstReasonCode  String   @map("first_reason_code")
  lastReasonCode   String   @map("last_reason_code")
  observationCount Int      @default(1) @map("observation_count")
  firstObservedAt  DateTime @map("first_observed_at")
  lastObservedAt   DateTime @map("last_observed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([fulfillmentId, storageLocator, artifactSha256])
  @@index([artifactSha256])
  @@index([lastObservedAt])
  @@map("ot_artifact_orphan_quarantine")
}
